# Public, browser-reachable URLs. Never put credentials or tokens in these values.
# Read by /api/config at runtime; origin or base ending in /api/v1 accepted.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STAFF_PORTAL_URL=http://localhost:8501

# Public HTTPS access stays disabled until Module 4 fixes URL-session restoration
# and its student RBAC/gateway integration is reviewed. Local opt-in is below.
# These must be passed into the running frontend container to take effect.
SAIV_STUDENT_PORTAL_ENABLED=false
NEXT_PUBLIC_STUDENT_PORTAL_URL=
SAIV_STUDENT_PORTAL_LOCAL_ONLY=false

# Temporary local-only review (production build is supported). Set all three:
# SAIV_STUDENT_PORTAL_ENABLED=true
# SAIV_STUDENT_PORTAL_LOCAL_ONLY=true
# NEXT_PUBLIC_STUDENT_PORTAL_URL=http://localhost:8501/portal/
# The local-only mode accepts browser/destination hosts localhost or 127.0.0.1.
# Non-local origins, including the HTTPS Dev Tunnel, keep the action disabled.
