DATABASE_URL=postgresql://saiv:saiv_password@localhost:5434/saiv
REDIS_URL=redis://localhost:6380
SECRET_KEY=your-secret-key-change-in-production
FACE_SERVICE_URL=http://localhost:8001
# Browser origins allowed to read API responses, comma separated. Append a
# tunnel origin here when demoing off-machine, e.g.
#   http://localhost:3000,https://<id>-3000.asse.devtunnels.ms
ALLOWED_ORIGINS=http://localhost:3000

# Rate limits. The defaults are the published ones in
# docs/API-SPECIFICATION.md and need no entry here; these exist so a bad
# bucket can be widened with a restart rather than a redeploy. REDIS_URL
# above is where the counters live; without it they are counted per process.
#RATE_LIMIT_LOGIN_PER_HOUR=60
#RATE_LIMIT_REGISTER_PER_HOUR=10
#RATE_LIMIT_API_PER_HOUR=1000
#RATE_LIMIT_CHECKIN_PER_MINUTE=10
# Switch every limit off. For load-testing a local stack only.
#RATE_LIMIT_ENABLED=false
