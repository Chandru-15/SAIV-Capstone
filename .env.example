# Copy to .env and edit. Every variable is optional: docker-compose.yml
# falls back to the defaults shown here when a value is unset.
# Never commit .env — keep it in .gitignore.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=saiv
# Avoid URL-reserved characters (@ : / ? # %) — this value is embedded
# in DATABASE_URL connection strings.
POSTGRES_PASSWORD=saiv_password
POSTGRES_DB=saiv

# --- Backend ----------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-change-in-production
# Comma separated. Append a tunnel origin when demoing off-machine, e.g.
#   http://localhost:3000,https://<id>-3000.asse.devtunnels.ms
ALLOWED_ORIGINS=http://localhost:3000

# Per-client-address rate limits. Raise these when the backend cannot see real
# client addresses -- unset TRUSTED_PROXY_IPS means every caller looks like the
# docker bridge gateway and shares one bucket, so a whole cohort enrolling or
# signing in at once runs into a budget meant for one person. docker-compose.yml
# already defaults them to cohort-sized values; lower them once the backend sits
# behind a reverse proxy whose address is in TRUSTED_PROXY_IPS.
#RATE_LIMIT_REGISTER_PER_HOUR=2000
#RATE_LIMIT_LOGIN_PER_HOUR=3000

# --- Grafana ----------------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# --- Email (password-reset codes) -------------------------------------------
# Left unset, docker-compose.yml points the backend at the bundled mailpit
# service, which catches every message locally: open http://localhost:8025 to
# read the code. No account, no credentials, nothing reaches a real inbox.
#
# To send real email, point these at a provider's SMTP endpoint. The sender is
# plain SMTP with STARTTLS, so anything standard works:
#   Gmail    smtp.gmail.com        587   user = your address, password = a
#                                        16-char app password (needs 2FA on)
#   Brevo    smtp-relay.brevo.com  587   user + SMTP key from the Brevo console
#   Resend   smtp.resend.com       587   user "resend", password = an API key;
#                                        real sending needs a verified domain
# Remember SMTP_STARTTLS=1 for any of them -- the compose default is 0 because
# mailpit speaks plain SMTP. SMTP_FROM must be an address the provider lets you
# send as, or it will be rewritten or rejected.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASSWORD=your-16-char-app-password
#SMTP_FROM=SAIV <you@gmail.com>
#SMTP_STARTTLS=1
#SMTP_SSL=0
