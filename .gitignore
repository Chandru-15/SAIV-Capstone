# Local Phase 3A deployment state, credentials and model artifacts
.local/
# Keep stray/experimental model downloads out of the repository, but NOT the
# one the face service actually needs. w600k_mbf.onnx is tracked on purpose --
# a clone has to be able to start module 3 -- and git ignores only untracked
# files, so without this negation the rule silently did nothing for it while
# still hiding any REPLACEMENT from `git add .`.
module3-face-recognition/models/*.onnx
!module3-face-recognition/models/w600k_mbf.onnx
